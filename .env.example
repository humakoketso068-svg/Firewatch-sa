# Copy these into Render > your service > Environment (or into a local .env you do NOT commit).
# Every line is optional. A feature turns on when its variables are filled in.

# Live fire data  (free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
# FIRMS_DAYS=2             # how many days of detections to show (1-5)
# FIRMS_REFRESH_MIN=15     # minutes between NASA downloads (minimum 10)

# Shared database for citizen reports and alert subscribers (https://supabase.com, free tier)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=      # the "service_role" key. Keep it secret. Server only.

# SMS alerts (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=               # your Twilio number, e.g. +15551234567

# Email alerts (any SMTP server; for Gmail use an "app password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=

# Alert behaviour
# ALERT_RADIUS_KM=30       # alert when a hotspot is this close to the person's town
# ALERT_COOLDOWN_H=3       # at most one message per person per this many hours
